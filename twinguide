#!/bin/sh
set -eu

project_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

usage() {
    echo "Usage: ./twinguide {generate|process|validate} ..."
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
    exit 0
fi
if [ "$#" -eq 0 ]; then
    usage >&2
    exit 2
fi

exec "$project_directory/scripts/blender.sh" \
    --background \
    --factory-startup \
    --python-expr \
    "from twin_guide.cli import main; main()" \
    -- "$@"
